# Copy to .env.local for development. In production, set these in Vercel → Project → Settings → Environment Variables.

# Supabase (Project Settings → API). The publishable key is safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Production domain, used for metadata (OG/canonical URLs), robots.txt and sitemap.xml.
# Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Server-only secret: BYPASSES RLS and can create Auth users. NEVER prefix with NEXT_PUBLIC_,
# never commit a real value. Only read by lib/supabase/admin.ts (via lib/env.server.ts)
# and scripts/create-staff-user.mjs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PayMongo: the platform's own (parent) account. Firms' accounts are linked under it, and
# payments are made on each firm's behalf, so the money settles to the firm. Server-only.
PAYMONGO_SECRET_KEY=sk_test_your-platform-secret-key

# Shared secret for scheduled jobs (at least 32 characters). Vercel Cron sends it automatically;
# any other scheduler calls /api/cron/reconcile-payments with "Authorization: Bearer <secret>".
CRON_SECRET=generate-a-long-random-value
