# Secrets for the send-reminders Edge Function. These are NOT Vite/frontend
# env vars (do not put them in the project-root .env) — set them for real via:
#   supabase secrets set --env-file supabase/functions/send-reminders/.env
# or one at a time with `supabase secrets set KEY=value`.
# For local testing: `supabase functions serve send-reminders --env-file supabase/functions/send-reminders/.env`

PHILSMS_API_TOKEN=your-philsms-api-token
PHILSMS_SENDER_ID=your-philsms-sender-id
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=reminders@yourdomain.com
